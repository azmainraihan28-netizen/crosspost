# ─── Core ────────────────────────────────────────────────────────────────
# Public URL of the app (no trailing slash). Used for OAuth redirects and Stripe return URLs.
APP_URL=http://localhost:3000
# Signs session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Encrypts social tokens at rest (falls back to AUTH_SECRET). Changing it invalidates stored tokens.
ENCRYPTION_KEY=
# Optional public support email shown on the privacy, terms and data deletion pages.
SUPPORT_EMAIL=

# ─── Database (libSQL / SQLite) ──────────────────────────────────────────
# Local file by default. In production use Turso: libsql://<db>-<org>.turso.io
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# ─── Scheduler ───────────────────────────────────────────────────────────
# "false" on serverless hosts (Vercel); then call /api/cron/publish every minute.
INTERNAL_SCHEDULER=true
# Bearer token required by /api/cron/publish
CRON_SECRET=

# Let networks without OAuth credentials connect as simulated demo accounts. Set "false" in production.
DEMO_MODE=true

# ─── AI (OpenAI; Anthropic optional) ─────────────────────────────────────
OPENAI_API_KEY=
# Optional override. Default: gpt-5.5
OPENAI_MODEL=
# Alternative provider, used only when OPENAI_API_KEY is empty
ANTHROPIC_API_KEY=
# Optional override. Default: claude-opus-5
ANTHROPIC_MODEL=

# ─── Stripe (test mode) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: a recurring Price ID. If empty, a $19/month price is created inline at checkout.
STRIPE_PRICE_ID=

# ─── Media uploads ───────────────────────────────────────────────────────
# Required in production so Instagram/Threads/Facebook can fetch images. Empty = save to /public/uploads.
BLOB_READ_WRITE_TOKEN=

# ─── Social OAuth apps ───────────────────────────────────────────────────
# Callback URL for each: {APP_URL}/api/connect/{platform}/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
# Optional Meta Graph API version (default v23.0)
META_GRAPH_VERSION=
